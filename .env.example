# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: MongoDB connection string (e.g., MongoDB Atlas or local mongod).
# Example: mongodb+srv://username:password@cluster0.mongodb.net/devfolio?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://user:pass@cluster0.example.mongodb.net/portfolio?retryWrites=true&w=majority"

# AUTH_SECRET: Secret key for signing admin authentication JWT tokens and session cookies.
AUTH_SECRET="devfolio_super_secure_jwt_secret_change_in_production_key_32chars"

# Admin panel credentials (only this account can log in at /admin)
ADMIN_EMAIL="shivamshukla13jun@gmail.com"
ADMIN_PASSWORD="change_this_password"
ADMIN_NAME="Shivam Shukla (Admin)"

# NEXT_PUBLIC_APP_URL: The base public URL for this application.
="http://localhost:3000"

# APP_URL: Runtime Cloud Run service URL
APP_URL="MY_APP_URL"
